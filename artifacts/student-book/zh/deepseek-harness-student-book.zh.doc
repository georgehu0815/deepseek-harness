<span id="cb320-3"><a href="#cb320-3" aria-hidden="true" tabindex="-1"></a>  <span class="co">/** Registered LLM provider route. */</span></span>
<span id="cb320-4"><a href="#cb320-4" aria-hidden="true" tabindex="-1"></a>  <span class="kw">readonly</span> provider<span class="op">:</span> <span class="dt">string</span></span>
<span id="cb320-5"><a href="#cb320-5" aria-hidden="true" tabindex="-1"></a>  <span class="co">/** Provider model id. */</span></span>
<span id="cb320-6"><a href="#cb320-6" aria-hidden="true" tabindex="-1"></a>  <span class="kw">readonly</span> model<span class="op">:</span> <span class="dt">string</span></span>
<span id="cb320-7"><a href="#cb320-7" aria-hidden="true" tabindex="-1"></a>}</span></code></pre></div>
<div class="sourceCode" id="cb321"><pre class="sourceCode ts"><code class="sourceCode typescript"><span id="cb321-1"><a href="#cb321-1" aria-hidden="true" tabindex="-1"></a><span class="co">/** Durable ownership record for an accepted session title. */</span></span>
<span id="cb321-2"><a href="#cb321-2" aria-hidden="true" tabindex="-1"></a><span class="kw">type</span> SessionTitleSource <span class="op">=</span></span>
<span id="cb321-3"><a href="#cb321-3" aria-hidden="true" tabindex="-1"></a>  <span class="op">|</span> { <span class="kw">readonly</span> kind<span class="op">:</span> <span class="st">&#39;fallback&#39;</span> }</span>
<span id="cb321-4"><a href="#cb321-4" aria-hidden="true" tabindex="-1"></a>  <span class="op">|</span> {</span>
<span id="cb321-5"><a href="#cb321-5" aria-hidden="true" tabindex="-1"></a>    <span class="kw">readonly</span> kind<span class="op">:</span> <span class="st">&#39;provider&#39;</span></span>
<span id="cb321-6"><a href="#cb321-6" aria-hidden="true" tabindex="-1"></a>    <span class="kw">readonly</span> provider<span class="op">:</span> SessionTitleProviderId</span>
<span id="cb321-7"><a href="#cb321-7" aria-hidden="true" tabindex="-1"></a>    <span class="kw">readonly</span> model<span class="op">?:</span> SessionTitleModelProvenance</span>
