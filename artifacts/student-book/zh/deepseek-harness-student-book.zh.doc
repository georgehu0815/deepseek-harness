<span id="cb95-143"><a href="#cb95-143" aria-hidden="true" tabindex="-1"></a>      anchorSeq<span class="op">:</span> context<span class="op">.</span><span class="at">start</span><span class="op">?.</span><span class="at">event</span><span class="op">.</span><span class="at">seq</span> <span class="op">??</span> context<span class="op">.</span><span class="at">matches</span>[<span class="dv">0</span>]<span class="op">?.</span><span class="at">event</span><span class="op">.</span><span class="at">seq</span> <span class="op">??</span> <span class="dv">0</span><span class="op">,</span></span>
