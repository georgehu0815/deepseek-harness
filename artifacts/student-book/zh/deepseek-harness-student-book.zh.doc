<span id="cb537-81"><a href="#cb537-81" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@param</span><span class="co"> </span><span class="cv">agent</span><span class="co"> - candidate exact live Agent.</span></span>
<span id="cb537-82"><a href="#cb537-82" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@returns</span><span class="co"> Team membership, or undefined for non-Team subagents and stale identities.</span></span>
<span id="cb537-83"><a href="#cb537-83" aria-hidden="true" tabindex="-1"></a><span class="co"> */</span></span>
<span id="cb537-84"><a href="#cb537-84" aria-hidden="true" tabindex="-1"></a><span class="fu">tryMembership</span>(agent<span class="op">:</span> Agent)<span class="op">:</span> TeamMembership <span class="op">|</span> <span class="dt">undefined</span></span></code></pre></div>
