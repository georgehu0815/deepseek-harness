<span id="cb450-167"><a href="#cb450-167" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@returns</span><span class="co"> Null after reporting or ignoring a stale/startup failure.</span></span>
<span id="cb450-168"><a href="#cb450-168" aria-hidden="true" tabindex="-1"></a><span class="co"> */</span></span>
<span id="cb450-169"><a href="#cb450-169" aria-hidden="true" tabindex="-1"></a>@<span class="fu">Remote</span>(<span class="st">&#39;reportClientGuardFailure&#39;</span>) <span class="kw">async</span> <span class="fu">reportClientGuardFailure</span>( agent<span class="op">:</span> Agent<span class="op">,</span> pluginId<span class="op">:</span> CordisDynamicPluginId<span class="op">,</span> pluginRunId<span class="op">:</span> CordisDynamicPluginRunId<span class="op">,</span> failure<span class="op">:</span> CordisErrorDetails<span class="op">,</span> )<span class="op">:</span> <span class="bu">Promise</span><span class="op">&lt;</span><span class="dt">null</span><span class="op">&gt;</span></span>
