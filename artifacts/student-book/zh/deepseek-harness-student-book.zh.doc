<span id="cb537-18"><a href="#cb537-18" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@param</span><span class="co"> </span><span class="cv">request</span><span class="co"> - immutable name, description, prompt, context mode, provider, and cancellation.</span></span>
<span id="cb537-19"><a href="#cb537-19" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@returns</span><span class="co"> the active roster row.</span></span>
<span id="cb537-20"><a href="#cb537-20" aria-hidden="true" tabindex="-1"></a><span class="co"> */</span></span>
<span id="cb537-21"><a href="#cb537-21" aria-hidden="true" tabindex="-1"></a><span class="kw">async</span> <span class="fu">spawnTeammate</span>(caller<span class="op">:</span> Agent<span class="op">,</span> request<span class="op">:</span> SpawnTeammateRequest)<span class="op">:</span> <span class="bu">Promise</span><span class="op">&lt;</span>SpawnTeammateResult<span class="op">&gt;</span></span>
