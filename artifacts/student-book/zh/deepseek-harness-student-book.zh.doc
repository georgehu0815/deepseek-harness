<span id="cb337-6"><a href="#cb337-6" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@returns</span><span class="co"> deterministic path-only candidates.</span></span>
<span id="cb337-7"><a href="#cb337-7" aria-hidden="true" tabindex="-1"></a><span class="co"> */</span></span>
<span id="cb337-8"><a href="#cb337-8" aria-hidden="true" tabindex="-1"></a><span class="kw">abstract</span> <span class="fu">list</span>( agent<span class="op">:</span> Agent<span class="op">,</span> query<span class="op">:</span> <span class="dt">string</span><span class="op">,</span> signal<span class="op">:</span> AbortSignal<span class="op">,</span> )<span class="op">:</span> <span class="bu">Promise</span><span class="op">&lt;</span>FileReferenceCandidate[]<span class="op">&gt;</span></span>
<span id="cb337-9"><a href="#cb337-9" aria-hidden="true" tabindex="-1"></a></span>
<span id="cb337-10"><a href="#cb337-10" aria-hidden="true" tabindex="-1"></a><span class="co">/**</span></span>
<span id="cb337-11"><a href="#cb337-11" aria-hidden="true" tabindex="-1"></a><span class="co"> * Remote face of {</span><span class="an">@link</span><span class="co"> </span><span class="cv">list}</span><span class="co">; the decorator cannot mark the abstract</span></span>
