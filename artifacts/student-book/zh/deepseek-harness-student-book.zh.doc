<span id="cb537-37"><a href="#cb537-37" aria-hidden="true" tabindex="-1"></a><span class="kw">async</span> <span class="fu">createTask</span>(caller<span class="op">:</span> Agent<span class="op">,</span> request<span class="op">:</span> CreateTeamTaskRequest)<span class="op">:</span> <span class="bu">Promise</span><span class="op">&lt;</span>TeamTaskView<span class="op">&gt;</span></span>
