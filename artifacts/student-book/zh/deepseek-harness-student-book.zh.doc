<span id="cb537-4"><a href="#cb537-4" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@returns</span><span class="co"> its root, Team identity, role, and model-facing name.</span></span>
<span id="cb537-5"><a href="#cb537-5" aria-hidden="true" tabindex="-1"></a><span class="co"> */</span></span>
<span id="cb537-6"><a href="#cb537-6" aria-hidden="true" tabindex="-1"></a><span class="fu">membership</span>(agent<span class="op">:</span> Agent)<span class="op">:</span> TeamMembership</span>
<span id="cb537-7"><a href="#cb537-7" aria-hidden="true" tabindex="-1"></a></span>
<span id="cb537-8"><a href="#cb537-8" aria-hidden="true" tabindex="-1"></a><span class="co">/**</span></span>
