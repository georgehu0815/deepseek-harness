<span id="cb537-74"><a href="#cb537-74" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@param</span><span class="co"> </span><span class="cv">targetName</span><span class="co"> - durable teammate name.</span></span>
<span id="cb537-75"><a href="#cb537-75" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@returns</span><span class="co"> the target status sampled before cancellation.</span></span>
<span id="cb537-76"><a href="#cb537-76" aria-hidden="true" tabindex="-1"></a><span class="co"> */</span></span>
<span id="cb537-77"><a href="#cb537-77" aria-hidden="true" tabindex="-1"></a><span class="fu">interrupt</span>(caller<span class="op">:</span> Agent<span class="op">,</span> targetName<span class="op">:</span> <span class="dt">string</span>)<span class="op">:</span> { previousStatus<span class="op">:</span> <span class="st">&#39;running&#39;</span> <span class="op">|</span> <span class="st">&#39;idle&#39;</span> <span class="op">|</span> <span class="st">&#39;inactive&#39;</span> }</span>
