<span id="cb451-3"><a href="#cb451-3" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@param</span><span class="co"> </span><span class="cv">pkg</span><span class="co"> - stable plugin, immutable package, run identity, and label.</span></span>
<span id="cb451-4"><a href="#cb451-4" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@mode</span><span class="co"> emit</span></span>
<span id="cb451-5"><a href="#cb451-5" aria-hidden="true" tabindex="-1"></a><span class="co"> */</span></span>
<span id="cb451-6"><a href="#cb451-6" aria-hidden="true" tabindex="-1"></a><span class="st">&#39;cordis/dynamic-package&#39;</span>(pkg<span class="op">:</span> DynamicCordisPackage)<span class="op">:</span> <span class="dt">void</span></span></code></pre></div>
<p>Source: <a href="https://github.com/deepseek-ai/deepseek-harness/blob/master/packages/extensions/cordis-host-runner/src/types.ts"><code>packages/extensions/cordis-host-runner/src/types.ts:379</code></a></p>
