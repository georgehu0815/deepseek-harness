<span id="cb95-68"><a href="#cb95-68" aria-hidden="true" tabindex="-1"></a><span class="kw">declare</span> <span class="im">module</span> <span class="st">&#39;@deepseek-ai/dsh-client-runtime/client&#39;</span> {</span>
<span id="cb95-69"><a href="#cb95-69" aria-hidden="true" tabindex="-1"></a>  <span class="kw">interface</span> ConversationStepDataMap {</span>
