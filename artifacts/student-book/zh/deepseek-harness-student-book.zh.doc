<span id="cb537-49"><a href="#cb537-49" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@param</span><span class="co"> </span><span class="cv">caller</span><span class="co"> - exact live Team member reading the board.</span></span>
<span id="cb537-50"><a href="#cb537-50" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@returns</span><span class="co"> detached current task views.</span></span>
<span id="cb537-51"><a href="#cb537-51" aria-hidden="true" tabindex="-1"></a><span class="co"> */</span></span>
<span id="cb537-52"><a href="#cb537-52" aria-hidden="true" tabindex="-1"></a><span class="fu">listTasks</span>(caller<span class="op">:</span> Agent)<span class="op">:</span> TeamTaskView[]</span>
<span id="cb537-53"><a href="#cb537-53" aria-hidden="true" tabindex="-1"></a></span>
<span id="cb537-54"><a href="#cb537-54" aria-hidden="true" tabindex="-1"></a><span class="co">/**</span></span>
