<span id="cb187-7"><a href="#cb187-7" aria-hidden="true" tabindex="-1"></a><span class="kw">async</span> <span class="fu">invoke</span>(request<span class="op">:</span> InvokeRemoteRequest)<span class="op">:</span> <span class="bu">Promise</span><span class="op">&lt;</span><span class="dt">unknown</span><span class="op">&gt;</span></span></code></pre></div>
