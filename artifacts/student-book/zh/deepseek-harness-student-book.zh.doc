<span id="cb537-11"><a href="#cb537-11" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@returns</span><span class="co"> Lead and teammate rows in creation order.</span></span>
<span id="cb537-12"><a href="#cb537-12" aria-hidden="true" tabindex="-1"></a><span class="co"> */</span></span>
<span id="cb537-13"><a href="#cb537-13" aria-hidden="true" tabindex="-1"></a><span class="fu">listMembers</span>(agent<span class="op">:</span> Agent)<span class="op">:</span> TeamMemberView[]</span>
