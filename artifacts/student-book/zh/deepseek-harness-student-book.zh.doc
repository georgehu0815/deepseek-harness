<span id="cb337-4"><a href="#cb337-4" aria-hidden="true" tabindex="-1"></a><span class="co"> * </span><span class="an">@param</span><span class="co"> </span><span class="cv">query</span><span class="co"> - path text following `</span><span class="an">@`</span><span class="co"> or `</span><span class="sc">@&quot;</span><span class="co">`.</span></span>
